{
  "name": "local-meet-translator-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Desktop controller for Local Meet Translator bridge, voice conversion service, settings and extension bootstrap.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis --x64",
    "package:mac": "electron-builder --mac dmg",
    "package:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "electron": "^31.7.7"
  },
  "build": {
    "appId": "local.meet.translator.desktop",
    "productName": "Local Meet Translator",
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../edge-extension",
        "to": "edge-extension"
      },
      {
        "from": "../local-meet-bridge",
        "to": "local-meet-bridge"
      },
      {
        "from": "../voice-conversion",
        "to": "voice-conversion"
      },
      {
        "from": "../scripts",
        "to": "scripts"
      },
      {
        "from": "../.env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Local Meet Translator",
      "uninstallDisplayName": "Local Meet Translator",
      "deleteAppDataOnUninstall": false
    }
  }
}
