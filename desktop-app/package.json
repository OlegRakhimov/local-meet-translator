{
  "name": "local-meet-translator-desktop",
  "version": "1.0.7",
  "private": true,
  "description": "Desktop controller for Local Meet Translator bridge, voice conversion service, settings and extension bootstrap.",
  "author": "Oleg",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis --x64",
    "package:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "26.15.3",
    "temp": "file:./npm-overrides/temp"
  },
  "overrides": {
    "@electron/asar": "4.2.0",
    "@electron/get": "5.0.0",
    "electron-winstaller": {
      "temp": "$temp"
    }
  },
  "build": {
    "appId": "local.meet.translator.desktop",
    "productName": "Local Meet Translator",
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../chrome-extension",
        "to": "browser-extensions/chrome-extension"
      },
      {
        "from": "../edge-extension",
        "to": "browser-extensions/edge-extension"
      },
      {
        "from": "../firefox-extension",
        "to": "browser-extensions/firefox-extension"
      },
      {
        "from": "../local-meet-bridge/target",
        "to": "local-meet-bridge/target",
        "filter": [
          "local-meet-bridge.jar"
        ]
      },
      {
        "from": "../local-meet-bridge/target/java-runtime",
        "to": "java-runtime"
      },
      {
        "from": "../voice-conversion/target",
        "to": "voice-conversion",
        "filter": [
          "local-meet-voice-conversion.exe"
        ]
      },
      {
        "from": "../.env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Local Meet Translator",
      "uninstallDisplayName": "Local Meet Translator",
      "deleteAppDataOnUninstall": false
    }
  }
}
