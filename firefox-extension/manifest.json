{
  "manifest_version": 2,
  "name": "Local Meet Translator (Firefox)",
  "version": "1.7.1",
  "description": "Thin client for Local Meet Translator desktop app in Firefox.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://app.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "browser_action": {
    "default_title": "Local Meet Translator",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "firefox_audio.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://app.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "firefox_page_bridge_loader.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "firefox_page_bridge.js"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "local-meet-translator@example.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personalCommunications",
          "personallyIdentifyingInfo"
        ]
      }
    }
  }
}
