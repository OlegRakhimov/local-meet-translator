# Copy this file to .env (DO NOT COMMIT .env) and fill your values.
# Then run scripts/windows/run-bridge.ps1 which can load .env into environment variables.

OPENAI_API_KEY=sk-your-openai-key-here
LOCAL_MEET_TRANSLATOR_PORT=8799
LOCAL_MEET_TRANSLATOR_TOKEN=your-random-token-here

# Incoming interview recognition
# en-expected = auto detection first, then strict-English retry for suspicious non-English output
EXT_SOURCE_LANG=en-expected
EXT_TARGET_LANG=ru
EXT_CHUNK_SECONDS=4

# Models
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4o-mini

# Optional TTS (local playback)
ENABLE_TTS=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_SPEED=1.0

# Optional voice conversion (RVC hook) — used in later tasks
ENABLE_VOICE_CONVERSION=false
VOICE_CONVERSION_URL=http://127.0.0.1:18799
VOICE_CONVERSION_TOKEN=
VOICE_CONVERSION_FALLBACK_TO_ORIGINAL=true
VOICE_CONVERSION_TIMEOUT_MS=180000

# voice-conversion service runtime (Task 1)
VOICE_CONVERSION_HOST=127.0.0.1
VOICE_CONVERSION_PORT=18799

# External RVC inference command (optional; passthrough if empty)
# Placeholders:
#   {input}    - path to input wav
#   {output}   - path to output wav
#   {modelTag} - user-provided model tag
# Example:
# RVC_INFER_CMD=python rvc_infer.py --model {modelTag} --input {input} --output {output}
RVC_INFER_CMD=
RVC_INFER_TIMEOUT_SEC=180

# Local protected subtitle window (Stage 2)
SUBTITLE_WINDOW_ENABLED=true
SUBTITLE_WINDOW_CONTENT_PROTECTION=true
SUBTITLE_WINDOW_ALWAYS_ON_TOP=true
SUBTITLE_WINDOW_CLICK_THROUGH=false
SUBTITLE_WINDOW_MINIMAL_MODE=true
SUBTITLE_WINDOW_SHOW_ORIGINAL=true
SUBTITLE_WINDOW_SHOW_TRANSLATION=true
SUBTITLE_WINDOW_FONT_SIZE=28
SUBTITLE_WINDOW_BACKGROUND_OPACITY=0.82
SUBTITLE_WINDOW_MAX_LINES=3
SUBTITLE_WINDOW_HOTKEY=CommandOrControl+Shift+S
SUBTITLE_WINDOW_CLICK_THROUGH_HOTKEY=CommandOrControl+Shift+X

# Exam compliance mode
# Disables AI answers, automatic analysis, teleprompter and capture-protected overlays.
# It does not hide the application, browser extension, processes, audio devices or network activity.
EXAM_COMPLIANCE_MODE=false

# Protected Live Interview Assistant window (Stage 5)
INTERVIEW_ASSISTANT_ENABLED=true
# Off by default to avoid unexpected OpenAI API usage. Local Answer Library matches never call the API.
INTERVIEW_ASSISTANT_AUTO_ANALYZE=false
INTERVIEW_ASSISTANT_CONTENT_PROTECTION=true
INTERVIEW_ASSISTANT_ALWAYS_ON_TOP=true
INTERVIEW_ASSISTANT_CLICK_THROUGH=false
INTERVIEW_ASSISTANT_COMPACT_OVERLAY=true
INTERVIEW_ASSISTANT_LANGUAGE_LEVEL=B1
INTERVIEW_ASSISTANT_ANSWER_STYLE=simple
INTERVIEW_ASSISTANT_FONT_SIZE=20
INTERVIEW_ASSISTANT_BACKGROUND_OPACITY=0.94
INTERVIEW_ASSISTANT_HOTKEY=CommandOrControl+Shift+A
INTERVIEW_ASSISTANT_CLICK_THROUGH_HOTKEY=CommandOrControl+Shift+Z
INTERVIEW_ASSISTANT_MOVE_HOTKEY=CommandOrControl+Shift+M

# Stage 6 English teleprompter. It only reformats an already prepared answer; it does not invent new facts.
INTERVIEW_TELEPROMPTER_ENABLED=true
INTERVIEW_TELEPROMPTER_FROZEN=false
INTERVIEW_TELEPROMPTER_CHUNK_MODE=medium
INTERVIEW_TELEPROMPTER_SHOW_KEYWORDS=true
INTERVIEW_TELEPROMPTER_SHOW_PLAN=true
INTERVIEW_TELEPROMPTER_AUTO_START=true
INTERVIEW_TELEPROMPTER_NEXT_HOTKEY=CommandOrControl+Shift+Right
INTERVIEW_TELEPROMPTER_PREVIOUS_HOTKEY=CommandOrControl+Shift+Left
INTERVIEW_TELEPROMPTER_FREEZE_HOTKEY=CommandOrControl+Shift+F
INTERVIEW_TELEPROMPTER_LOAD_PENDING_HOTKEY=CommandOrControl+Shift+Enter
